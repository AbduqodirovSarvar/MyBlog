<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>MyBlog.Domain.Tests</RootNamespace>
    <!-- .NET 10 SDK'da "dotnet test" VSTest rejimida: xunit.runner.visualstudio orqali ishga tushadi.
         Agar global.json'da MTP runner yoqilsa, bu qatorni olib tashlash kerak. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MyBlog.Domain\MyBlog.Domain.csproj" />
  </ItemGroup>

</Project>
